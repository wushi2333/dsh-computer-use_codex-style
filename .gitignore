# --- plugin / node ---------------------------------------------------------
# The plugin is installed into a DSH profile as a linked package; node_modules
# is never part of the repository.
node_modules/

# --- Rust helper build output ---------------------------------------------
# The helper is built from helper-rs/ (`cargo build --release`); only the build CACHE is
# ignored. The shipped, committed binary lives in helper-rs/bin/<platform>-<arch>/ and is what
# a fresh checkout (or an install without a Rust toolchain) runs -- refresh it with
# scripts/ship-helper.ps1 whenever helper-rs/ changes.
helper-rs/target/
*.pdb
*.dSYM/

# --- Linux Rust helper build output (helper-linux/) -----------------------
# The Linux helper is built from helper-linux/ with the same `cargo build`; only its build
# cache is ignored. Nothing is committed under bin/ for Linux: the JS side reads
# helper-linux/target/{release,debug}/dsh-computer-use, so a checkout without a Rust
# toolchain has no Linux helper until one is built.
helper-linux/target/

# --- Python engine ---------------------------------------------------------
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# --- macOS Swift helper ----------------------------------------------------
# The Swift *source* is tracked (it is the darwin helper); only its SPM build output is not.
helper-swift/.build/

# --- Research material that stays local -----------------------------------
# The reverse-engineering reports, the gap register and the verification log carry
# machine paths and third-party extracts; they are development evidence and are
# deliberately not part of the public source tree.
analysis/

# --- Local experience layer (runtime notes the agent writes) ---------------
# Written after Computer Use tasks on THIS machine: lessons.jsonl + lessons.md (readable),
# observations.jsonl (facts), pending.jsonl and manual.jsonl. Decision D-1 keeps the store
# inside the plugin folder, so it must never be committed or packed.
.experience/
.cu/

# --- Machine-local app catalog cache (helper runtime state) ----------------
# The Rust helper keeps the installed-app catalog in
# %LOCALAPPDATA%computer-use-app-catalog -- shell-apps.json plus the slow-request log. It
# lists THIS machine's installed applications and their paths, so it is per-user state that
# must never be committed. The path comes from LOCALAPPDATA and is therefore outside the
# repository already; these patterns are the belt for a test or a probe that points
# LOCALAPPDATA at the checkout, where the file would otherwise appear as untracked.
computer-use-app-catalog/
shell-apps.json
slow-requests.log

# --- Local machine state and research scratch (not part of the plugin) -----
.grok/
_session-diary*/
paritycursor-test.jpg
*.log

# --- Generated gate evidence ----------------------------------------------
# Screenshots and run logs are regenerated by parity/verify-all.ps1. The *text*
# fixtures ARE tracked: parity/golden-ax/ and parity/ax-rich/ hold the official
# helper's own output, which is the reference these gates compare against.
parity/*.png
parity/*.jpg
parity/*.jpeg
parity/_verify-all-*.txt
