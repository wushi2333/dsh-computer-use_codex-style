{
  "name": "dsh-computer-use",
  "version": "0.1.0",
  "description": "Windows Computer Use for DeepSeek Harness: Codex-parity window2 + browser, no Codex required",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./tool": "./src/tool.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "dsh-plugin.json",
    "skills",
    "scripts",
    "helper-rs/bin",
    "helper-rs/assets",
    "computer_use",
    "parity/official-constants.json",
    "docs/plugin-readme.md",
    "docs/plugin-readme.zh.md",
    "README.zh-CN.md"
  ],
  "author": "DeepSeek Harness",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wushi2333/dsh-computer-use_codex-style.git"
  },
  "homepage": "https://github.com/wushi2333/dsh-computer-use_codex-style#readme",
  "bugs": {
    "url": "https://github.com/wushi2333/dsh-computer-use_codex-style/issues"
  },
  "scripts": {
    "test:js": "node --test tests/contracts.test.mjs tests/interactive_summary.test.mjs",
    "test:units": "node --import ./tests/resolve-hooks.mjs --test tests/tool-units.test.mjs tests/tool-names.test.mjs tests/capabilities.test.mjs tests/drivers.test.mjs tests/ps-contract.test.mjs tests/telemetry.test.mjs tests/helper-modes.test.mjs",
    "check:ship": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/check-ship.ps1",
    "test:py": "python -m pytest tests",
    "test:ci": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/ci-smoke.ps1",
    "test": "npm run test:units && npm run check:ship && npm run test:js && npm run test:py"
  },
  "keywords": [
    "computer-use",
    "desktop-control",
    "windows",
    "automation",
    "window2",
    "ui-automation"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifest": "./dsh-plugin.json",
    "skills": "./skills/",
    "codexBaseline": "26.903.61454"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^0.1.6 || ^0.2.0",
    "@deepseek-ai/dsh-tools": "^0.1.6 || ^0.2.0",
    "@deepseek-ai/dsh-system-prompt": "^0.1.6 || ^0.2.0",
